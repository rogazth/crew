{
  "name": "crew",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "productName": "Crew",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "node scripts/app.mjs",
    "app:build": "node scripts/app-build.mjs",
    "icon": "node scripts/icon.mjs",
    "prepare": "husky",
    "lint": "eslint src",
    "doctor": "react-doctor src --no-score",
    "doctor:changed": "react-doctor src --scope changed --no-score",
    "check": "npm run lint && tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && npm run test && npm run doctor",
    "test": "vitest run",
    "stress": "vitest run stress && cargo test -p crew-core --release -- --ignored browser",
    "protocol": "cargo test -p crew-protocol",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/kumo": "^2.13.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.3.6",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@xterm/addon-fit": "^0.12.0-beta.301",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.17.0-beta.301",
    "@xterm/addon-unicode11": "^0.10.0-beta.301",
    "@xterm/addon-web-links": "^0.13.0-beta.301",
    "@xterm/addon-webgl": "^0.20.0-beta.300",
    "@xterm/xterm": "^6.1.0-beta.304",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "react-doctor": "^0.9.13",
    "tailwindcss": "^4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron": true,
    "electron-builder": true,
    "esbuild": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "rogazth.crew",
    "productName": "Crew",
    "artifactName": "Crew-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/crewd",
        "to": "crewd"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    }
  }
}
