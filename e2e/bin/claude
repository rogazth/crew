#!/usr/bin/env node
// A stand-in for Claude Code that the e2e sandbox puts first on the provider
// search path ($HOME/.local/bin). It takes the argv Crew builds in
// src/lib/sessionCommand.ts and leaves the traces Crew reads from the real one:
//
// - the terminal title: `✳ <name>` at rest, `◐◓◑◒ <name>` while a turn runs
//   (src/lib/terminalStatus.ts);
// - the transcript at ~/.claude/projects/<slug(cwd)>/<id>.jsonl, with `user`
//   records per turn and `ai-title` records for names (crates/crew-core/src/
//   claude_title.rs, provider_session.rs);
// - the hooks passed in `--settings`, each run with `sh -c` and the hook's
//   JSON on stdin, as Claude runs them: SessionStart on start and on /clear
//   (after SessionEnd), UserPromptSubmit and Stop around a turn,
//   PermissionRequest when it asks, PostToolUse once the tool ran. Esc stops a
//   turn, or denies what it asked, without a Stop hook, as Claude does.
//
// Its transcript has the shape of Claude Code 2.1.283's: a `user` record per
// prompt, `assistant` records with text and tool_use parts, `user` records
// with the tool_result, `[Request interrupted by user]` after an Esc, and a
// `system` `turn_duration` record closing each turn.
//
// It reads the terminal raw, like a TUI. A line is submitted with Enter;
// bracketed paste is accepted and a newline inside a paste does not submit.
//
//   work N        a turn that keeps printing for N seconds
//   background N  a short turn that leaves a shell running in the background
//                 and ends on it (Stop names it in `background_tasks`, as
//                 Claude Code 2.1.286's does); N seconds later the shell's
//                 notification starts a turn of its own, which ends with
//                 nothing left running
//   title <text>  names the session (ai-title record + OSC title)
//   rename <text> names it in the transcript alone (ai-title record); the
//                 terminal's title keeps the old name until its next repaint
//   ask           asks to run a Bash command: 1 or 2 allows it, 3 or Esc denies it
//   question      asks "Tea or coffee?" as an AskUserQuestion form: a digit
//                 picks, 3 then text and Enter answers in its own words
//   url <u>       clears the screen, and 300 ms later records the link as the
//                 answer in the transcript and prints it alone on the top
//                 line, from the first column: a test can point at it without
//                 knowing the cell size, once the transcript has it
//   !<command>    bash mode: runs the command with sh in the session's cwd
//   /clear        moves to a new session id, as Claude does
//   after N <cmd> runs <cmd> N seconds later, as if typed then: the CLI acting
//                 on its own while its tab is out of sight
//   anything else a short turn of about a second
//
// A folder with a `.untrusted` file in it opens on Claude's trust prompt, in
// its words: "No, exit" is picked, ↓ moves to "Yes, I trust this folder", and
// Enter answers (trusting removes the file). Esc exits. SessionStart runs
// once it is trusted, as the real one's does.
//
// A prompt after `--` is its first message, submitted as soon as it starts
// (after the trust prompt, if any), as the real one takes `claude -- <prompt>`.
//
// Resumed (`--resume`), it repaints the conversation for about a second before
// its title settles, the way Claude redraws a loaded transcript.
//
// Every launch appends its argv, cwd and pid as one JSON line to
// $HOME/fake-claude.log. Ctrl+C twice or Ctrl+D on an empty line exits.
//
// Builtins come from process.getBuiltinModule, so the file runs the same as a
// module (inside this package) and as a script (copied into a sandbox).
"use strict";
const { spawnSync } = process.getBuiltinModule("node:child_process");
const { randomUUID } = process.getBuiltinModule("node:crypto");
const fs = process.getBuiltinModule("node:fs");
const os = process.getBuiltinModule("node:os");
const path = process.getBuiltinModule("node:path");

const HOME = process.env.HOME || os.homedir();
const CWD = process.cwd();
const IDLE = "✳";
const SPIN = ["◐", "◓", "◑", "◒"];

const argv = process.argv.slice(2);
fs.appendFileSync(
  path.join(HOME, "fake-claude.log"),
  `${JSON.stringify({ argv, cwd: CWD, pid: process.pid, at: Date.now() })}\n`,
);

function flag(name) {
  const at = argv.indexOf(name);
  return at >= 0 && at + 1 < argv.length ? argv[at + 1] : null;
}

let settings = {};
try {
  settings = JSON.parse(flag("--settings") || "{}");
} catch {
  settings = {};
}
const resumeId = flag("--resume");
const model = flag("--model");
// ⇧Tab walks the modes as Claude Code 2.1.288 does without bypass on offer;
// each user record carries the one it was sent in, as the real transcript's do.
const MODES = ["default", "acceptEdits", "plan", "auto"];
let mode = argv.includes("--dangerously-skip-permissions") ? "bypassPermissions" : flag("--permission-mode") || "default";
let sessionId = resumeId || flag("--session-id") || randomUUID();

// Claude files a project's sessions under its cwd with every UTF-16 unit that
// is not ASCII alphanumeric replaced by a dash; a JS regex works on those units.
const projectDir = path.join(HOME, ".claude", "projects", CWD.replace(/[^a-zA-Z0-9]/g, "-"));
const transcript = () => path.join(projectDir, `${sessionId}.jsonl`);

const out = (text) => process.stdout.write(text);

// The real CLI refuses these two, and Crew's launcher has to pick right.
if (resumeId && !fs.existsSync(transcript())) {
  out(`No conversation found with session ID: ${resumeId}\r\n`);
  process.exit(1);
}
if (!resumeId && flag("--session-id") && fs.existsSync(transcript())) {
  out(`Error: Session ID ${sessionId} is already in use.\r\n`);
  process.exit(1);
}

function record(entry) {
  fs.mkdirSync(projectDir, { recursive: true });
  fs.appendFileSync(
    transcript(),
    `${JSON.stringify({ ...entry, uuid: randomUUID(), sessionId, cwd: CWD, timestamp: new Date().toISOString() })}\n`,
  );
}

const say = (text) =>
  record({ type: "assistant", message: { id: randomUUID(), role: "assistant", content: [{ type: "text", text }] } });
const toolUse = (id, name, input) =>
  record({ type: "assistant", message: { id: randomUUID(), role: "assistant", content: [{ type: "tool_use", id, name, input }] } });
const toolResult = (id, content, isError, extra = {}) =>
  record({
    type: "user",
    message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, content, is_error: isError }] },
    ...extra,
  });
let turnStarted = 0;
const turnEnd = () => record({ type: "system", subtype: "turn_duration", durationMs: Date.now() - turnStarted });
const interrupted = (forTool) =>
  record({
    type: "user",
    message: { role: "user", content: [{ type: "text", text: `[Request interrupted by user${forTool ? " for tool use" : ""}]` }] },
  });

/** The newest name in the transcript, as claude_title.rs reads it. */
function storedName() {
  try {
    let name = null;
    for (const line of fs.readFileSync(transcript(), "utf8").split("\n")) {
      if (!line.includes("-title")) continue;
      try {
        const entry = JSON.parse(line);
        if (entry.type === "ai-title" && entry.aiTitle) name = entry.aiTitle;
      } catch {}
    }
    return name;
  } catch {
    return null;
  }
}

function runHooks(event, payload, matchWith) {
  const groups = (settings.hooks && settings.hooks[event]) || [];
  for (const group of groups) {
    if (matchWith !== undefined && group.matcher && !new RegExp(`^(?:${group.matcher})$`).test(matchWith)) continue;
    for (const hook of group.hooks || []) {
      if (hook.type !== "command") continue;
      spawnSync("sh", ["-c", hook.command], {
        input: JSON.stringify({
          session_id: sessionId,
          transcript_path: transcript(),
          cwd: CWD,
          hook_event_name: event,
          ...payload,
        }),
        stdio: ["pipe", "ignore", "ignore"],
        cwd: CWD,
      });
    }
  }
}

let name = storedName() || "Claude Code";
let busy = false;
let spinner = null;
let spinAt = 0;
let pending = null; // what a key answers while `ask` waits

function title(mark) {
  out(`\x1b]0;${mark} ${name}\x07`);
}

function prompt() {
  out("\r\n> ");
}

function startSpin() {
  busy = true;
  title(SPIN[spinAt++ % SPIN.length]);
  spinner = setInterval(() => title(SPIN[spinAt++ % SPIN.length]), 120);
}

function stopSpin() {
  if (spinner) clearInterval(spinner);
  spinner = null;
  busy = false;
  title(IDLE);
}

/** Timers of the turn running now, so Esc can stop it. */
let running = [];

/** A turn that prints steadily for `ms`, then settles back at the prompt. */
function turn(ms, after, reply = "Done.", tasks) {
  startSpin();
  let n = 0;
  const ticker = setInterval(() => out(`\r\n  working… ${++n}`), 150);
  const end = setTimeout(() => {
    clearInterval(ticker);
    running = [];
    say(reply);
    turnEnd();
    out(`\r\n● ${reply}`);
    stopSpin();
    if (after) after();
    runHooks("Stop", { stop_hook_active: false, ...(tasks ? { background_tasks: tasks, session_crons: [] } : {}) });
    prompt();
  }, ms);
  running = [ticker, end];
}

/** A turn that ends on a shell left running; the shell's notification wakes the CLI `ms` later. */
function background(ms) {
  const task = { id: `b${randomUUID().slice(0, 8)}`, type: "shell", status: "running", description: "Run the build", command: "sleep" };
  turn(300, undefined, "Started the build in the background.", [task]);
  setTimeout(() => {
    const notice = `<task-notification>\n<task-id>${task.id}</task-id>\n<status>completed</status>\n</task-notification>`;
    runHooks("UserPromptSubmit", { prompt: notice });
    turn(300, undefined, "The build passed.", []);
  }, ms);
}

/** Esc while a turn runs: it stops where it is, and no Stop hook says so. */
function interrupt() {
  for (const timer of running) {
    clearInterval(timer);
    clearTimeout(timer);
  }
  running = [];
  interrupted(false);
  turnEnd();
  out("\r\n  ⎿  Interrupted · What should Claude do instead?");
  stopSpin();
  prompt();
}

function submit(line) {
  const text = line.trim();
  if (!text) return prompt();
  const later = /^after\s+(\d+(?:\.\d+)?)\s+(.+)$/.exec(text);
  if (later) {
    setTimeout(() => {
      out(`\r\n> ${later[2]}`);
      submit(later[2]);
    }, Number(later[1]) * 1000);
    return prompt();
  }
  if (text === "/clear") {
    runHooks("SessionEnd", { reason: "clear" });
    sessionId = randomUUID();
    name = "Claude Code";
    runHooks("SessionStart", { source: "clear" });
    out("\r\n(no content)");
    title(IDLE);
    return prompt();
  }
  record({ type: "user", permissionMode: mode, message: { role: "user", content: text } });
  turnStarted = Date.now();
  if (text.startsWith("!")) {
    const result = spawnSync("sh", ["-c", text.slice(1)], { cwd: CWD, encoding: "utf8" });
    out(`\r\n${`${result.stdout || ""}${result.stderr || ""}`.replace(/\n/g, "\r\n")}`);
    return prompt();
  }
  const [command, ...rest] = text.split(/\s+/);
  const arg = rest.join(" ");
  // Every command from here on is a turn of the model's.
  if (command !== "rename") runHooks("UserPromptSubmit", { prompt: text });
  if (command === "work") return turn(Math.max(0, Number(arg) || 1) * 1000);
  if (command === "background") return background(Math.max(0, Number(arg) || 1) * 1000);
  if (command === "title" && arg) {
    return turn(300, () => {
      name = arg;
      record({ type: "ai-title", aiTitle: arg });
      title(IDLE);
    });
  }
  if (command === "rename" && arg) {
    name = arg;
    record({ type: "ai-title", aiTitle: arg });
    return prompt();
  }
  if (command === "url" && arg) {
    // The screen clears at once, so the link printed before this one is gone
    // well before this one lands in the transcript and on screen.
    out("\x1b[2J\x1b[H");
    startSpin();
    setTimeout(() => {
      say(arg);
      turnEnd();
      out(`\x1b[2J\x1b[H${arg}`);
      stopSpin();
      runHooks("Stop", { stop_hook_active: false });
      prompt();
    }, 300);
    return;
  }
  if (command === "ask") {
    startSpin();
    const id = `toolu_${randomUUID().slice(0, 8)}`;
    const input = { command: "touch asked.txt", description: "Create asked.txt" };
    setTimeout(() => {
      toolUse(id, "Bash", input);
      runHooks("PreToolUse", { tool_name: "Bash", tool_input: input, tool_use_id: id });
      // Claude stops the spinner while it waits; only the hooks say why.
      if (spinner) clearInterval(spinner);
      spinner = null;
      title(IDLE);
      runHooks("PermissionRequest", {
        tool_name: "Bash",
        tool_input: input,
        permission_suggestions: [{ type: "addDirectories", directories: [CWD], destination: "session" }],
      });
      runHooks(
        "Notification",
        { message: "Claude needs your permission to use Bash", notification_type: "permission_prompt" },
        "permission_prompt",
      );
      out("\r\n Bash command\r\n   touch asked.txt\r\n Do you want to proceed?\r\n ❯ 1. Yes\r\n   2. Yes, and don't ask again\r\n   3. No");
      pending = (key) => {
        if (key === "1" || key === "2" || key === "\r") {
          toolResult(id, "", false);
          runHooks("PostToolUse", { tool_name: "Bash", tool_input: input, tool_use_id: id });
          turn(1000);
          return true;
        }
        if (key === "3" || key === "\x1b") {
          toolResult(id, "The user doesn't want to proceed with this tool use.", true, { toolUseResult: "User rejected tool use" });
          interrupt();
          return true;
        }
        return false;
      };
    }, 300);
    return;
  }
  if (command === "question") {
    startSpin();
    const id = `toolu_${randomUUID().slice(0, 8)}`;
    const question = { question: "Tea or coffee?", header: "Drink", multiSelect: false, options: [{ label: "Tea" }, { label: "Coffee" }] };
    setTimeout(() => {
      toolUse(id, "AskUserQuestion", { questions: [question] });
      if (spinner) clearInterval(spinner);
      spinner = null;
      title(IDLE);
      runHooks("PermissionRequest", { tool_name: "AskUserQuestion", tool_input: { questions: [question] } });
      out("\r\n Tea or coffee?\r\n ❯ 1. Tea\r\n   2. Coffee\r\n   3. Type something.");
      let typing = null;
      const answer = (label) => {
        toolResult(id, `User has answered your questions: "Tea or coffee?"="${label}".`, false, {
          toolUseResult: { questions: [question], answers: { [question.question]: label } },
        });
        runHooks("PostToolUse", { tool_name: "AskUserQuestion", tool_use_id: id });
        turn(500, undefined, `You picked ${label}.`);
      };
      pending = (key) => {
        if (typing !== null) {
          if (key === "\r") {
            answer(typing);
            return true;
          }
          if (key >= " ") {
            typing += key;
            out(key);
          }
          return false;
        }
        if (key === "1" || key === "2") {
          answer(question.options[Number(key) - 1].label);
          return true;
        }
        if (key === "3") {
          typing = "";
          out("\r\n > ");
          return false;
        }
        if (key === "\x1b") {
          toolResult(id, "The user dismissed the question.", true);
          interrupt();
          return true;
        }
        return false;
      };
    }, 300);
    return;
  }
  turn(1000);
}

// Input: raw bytes, escape sequences dropped, bracketed paste unwrapped.
let buffer = "";
let pasting = false;
let interrupts = 0;

function exit() {
  runHooks("SessionEnd", { reason: "prompt_input_exit" });
  out("\x1b[?2004l\x1b[?1004l\r\n");
  process.exit(0);
}

function onKey(ch) {
  if (pending && !pasting) {
    if (pending(ch)) pending = null;
    return;
  }
  if (ch === "\x1b") {
    if (busy) interrupt();
    return;
  }
  if (ch === "\x15") {
    // Ctrl+U: the line is cleared, as Claude's prompt does.
    buffer = "";
    out("\r\x1b[2K> ");
    return;
  }
  if (ch === "\x03") {
    if (buffer) {
      buffer = "";
      interrupts = 0;
      out("\r\n> ");
      return;
    }
    if (++interrupts >= 2) exit();
    out("\r\n  Press Ctrl-C again to exit");
    prompt();
    return;
  }
  interrupts = 0;
  if (ch === "\x04") {
    if (!buffer) exit();
    return;
  }
  if (ch === "\r" || ch === "\n") {
    if (pasting) {
      buffer += "\n";
      out("\r\n  ");
      return;
    }
    if (busy) return; // Claude queues it; the fake keeps it simple and waits.
    const line = buffer;
    buffer = "";
    submit(line);
    return;
  }
  if (ch === "\x7f" || ch === "\b") {
    if (buffer) {
      buffer = buffer.slice(0, -1);
      out("\b \b");
    }
    return;
  }
  if (ch < " ") return;
  buffer += ch;
  out(ch);
}

function feed(data) {
  let i = 0;
  while (i < data.length) {
    if (data.startsWith("\x1b[200~", i)) {
      pasting = true;
      i += 6;
      continue;
    }
    if (data.startsWith("\x1b[201~", i)) {
      pasting = false;
      i += 6;
      continue;
    }
    if (data[i] === "\x1b" && i === data.length - 1) {
      // Esc on its own: stop, or no.
      onKey("\x1b");
      i += 1;
      continue;
    }
    if (data.startsWith("\x1b[Z", i)) {
      if (MODES.includes(mode)) mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
      i += 3;
      continue;
    }
    if (data[i] === "\x1b") {
      // CSI (ESC [ … final byte), SS3 (ESC O x) or a lone Alt+key: none of them type text.
      if (data[i + 1] === "[") {
        let j = i + 2;
        while (j < data.length && !/[@-~]/.test(data[j])) j++;
        i = j + 1;
      } else {
        i += data[i + 1] === "O" ? 3 : 2;
      }
      continue;
    }
    const code = data.codePointAt(i);
    const ch = String.fromCodePoint(code);
    i += ch.length;
    onKey(ch);
  }
}

// Raw before the SessionStart hook runs, so a test that waits for the hook's
// record (in $CREW_CLAUDE_BIND_DIR, `claudeStarts` in the harness) knows keys
// typed from then on land.
if (process.stdin.isTTY) process.stdin.setRawMode(true);
process.stdin.setEncoding("utf8");
process.stdin.on("data", feed);
process.stdin.on("end", () => process.exit(0));
for (const signal of ["SIGHUP", "SIGTERM"]) process.on(signal, () => process.exit(0));

const untrusted = path.join(CWD, ".untrusted");
if (fs.existsSync(untrusted)) askTrust();
else start();

function start() {
  runHooks("SessionStart", { source: resumeId ? "resume" : "startup" });
  // Bracketed paste and focus reporting on, as Claude turns them on.
  out("\x1b[?2004h\x1b[?1004h");
  out(`Fake Claude Code${model ? ` (${model})` : ""}\r\n`);
  out(`  session ${sessionId}\r\n  cwd ${CWD}\r\n`);
  // A message after `--` is the first turn, a resume's too (`claude -r <id> -- "query"`).
  const dash = argv.indexOf("--");
  const first = dash >= 0 ? argv.slice(dash + 1).join(" ") : "";
  const ready = () => {
    title(IDLE);
    out("> ");
    if (first) {
      out(first);
      submit(first);
    }
  };
  if (resumeId) {
    out("  resumed\r\n");
    redraw(ready);
  } else {
    ready();
  }
}

/** Claude 2.1.283's folder trust prompt: keys answer it, not typed text. */
function askTrust() {
  let yes = false;
  const draw = () =>
    out(
      "\x1b[2J\x1b[H Accessing workspace:\r\n " +
        CWD +
        "\r\n Quick safety check: Is this a project you created or one you trust?\r\n" +
        ` ${yes ? " " : "❯"} No, exit\r\n ${yes ? "❯" : " "} Yes, I trust this folder\r\n` +
        " Enter to confirm · Esc to cancel",
    );
  draw();
  process.stdin.removeListener("data", feed);
  const answer = (data) => {
    if (data === "\x1b[B" || data === "\x1b[A") {
      yes = data === "\x1b[B";
      draw();
      return;
    }
    if (data === "\x1b") exit();
    if (data !== "\r") return;
    if (!yes) exit();
    process.stdin.removeListener("data", answer);
    process.stdin.on("data", feed);
    fs.rmSync(untrusted, { force: true });
    out("\x1b[2J\x1b[H");
    start();
  };
  process.stdin.on("data", answer);
}

/** The loaded conversation, painted frame by frame, as a resume does before it settles. */
function redraw(done) {
  const history = [];
  try {
    for (const line of fs.readFileSync(transcript(), "utf8").split("\n")) {
      try {
        const entry = JSON.parse(line);
        if (entry.type === "user") history.push(`> ${entry.message.content}`);
        if (entry.type === "assistant") history.push("● Done.");
      } catch {}
    }
  } catch {}
  let frame = 0;
  const painter = setInterval(() => {
    out(`\x1b[2J\x1b[H  loading conversation ${++frame}\r\n${history.join("\r\n")}\r\n`);
    if (frame < 9) return;
    clearInterval(painter);
    done();
  }, 120);
}
