#!/usr/bin/env node
// A stand-in for the `claude` CLI, for the e2e specs: it speaks the stream-json
// protocol Crew drives a session over (`-p --input-format stream-json
// --output-format stream-json`), one process for every turn as the real
// CLI's does, and writes the conversation to a transcript of the shape of
// Claude Code 2.1.283's so a relaunch can resume it.
//
//   work N        a turn that keeps going for N seconds before it answers
//   agent         a turn that sends a subagent to the background
//   !<command>    runs the command with sh in the session's cwd, with the
//                 environment the CLI was given (CREW_SOCKET, CREW_TOKEN), as a
//                 model's Bash tool would, then answers as any turn does
//   late <text>   a message the running turn reads three seconds after it came
//   anything else a short turn that answers `Reply <n>: <message>`
//
// Every launch appends its argv, cwd and pid as one JSON line to
// $HOME/fake-claude.log.
//
// Builtins come from process.getBuiltinModule, so the file runs the same as a
// module (inside this package) and as a script (copied into a sandbox).
"use strict";
const { spawn } = process.getBuiltinModule("node:child_process");
const { randomUUID } = process.getBuiltinModule("node:crypto");
const fs = process.getBuiltinModule("node:fs");
const os = process.getBuiltinModule("node:os");
const path = process.getBuiltinModule("node:path");

const HOME = process.env.HOME || os.homedir();
const CWD = process.cwd();
const argv = process.argv.slice(2);
fs.appendFileSync(
  path.join(HOME, "fake-claude.log"),
  `${JSON.stringify({ argv, cwd: CWD, pid: process.pid, at: Date.now() })}\n`,
);

function flag(name) {
  const at = argv.indexOf(name);
  return at >= 0 && at + 1 < argv.length ? argv[at + 1] : null;
}


const resumeId = flag("--resume");
let model = flag("--model");
let mode = argv.includes("--dangerously-skip-permissions") ? "bypassPermissions" : flag("--permission-mode") || "default";
let sessionId = resumeId || flag("--session-id") || randomUUID();

// Claude files a project's sessions under its cwd with every UTF-16 unit that
// is not ASCII alphanumeric replaced by a dash; a JS regex works on those units.
const projectDir = path.join(HOME, ".claude", "projects", CWD.replace(/[^a-zA-Z0-9]/g, "-"));
const transcript = () => path.join(projectDir, `${sessionId}.jsonl`);

// The real CLI refuses these two, and Crew's launcher has to pick right.
// Over the protocol it says so on stderr, which is where Crew reads it.
const refuse = (text) => process.stderr.write(`${text}\r\n`);
if (resumeId && !fs.existsSync(transcript())) {
  refuse(`No conversation found with session ID: ${resumeId}`);
  process.exit(1);
}
if (!resumeId && flag("--session-id") && fs.existsSync(transcript())) {
  refuse(`Error: Session ID ${sessionId} is already in use.`);
  process.exit(1);
}

function record(entry) {
  fs.mkdirSync(projectDir, { recursive: true });
  fs.appendFileSync(
    transcript(),
    `${JSON.stringify({ ...entry, uuid: randomUUID(), sessionId, cwd: CWD, timestamp: new Date().toISOString() })}\n`,
  );
}

const say = (text) =>
  record({ type: "assistant", message: { id: randomUUID(), role: "assistant", content: [{ type: "text", text }] } });
let turnStarted = 0;
const turnEnd = () => record({ type: "system", subtype: "turn_duration", durationMs: Date.now() - turnStarted });
const interrupted = (forTool) =>
  record({
    type: "user",
    message: { role: "user", content: [{ type: "text", text: `[Request interrupted by user${forTool ? " for tool use" : ""}]` }] },
  });

for (const signal of ["SIGHUP", "SIGTERM"]) process.on(signal, () => process.exit(0));

serve();

/**
 * The stream-json protocol Crew drives a session over, as
 * Claude Code 2.1.295 speaks it with `-p --input-format stream-json
 * --output-format stream-json`: a JSON object a line each way.
 *
 * - `control_request`s are answered with a success `control_response`:
 *   `initialize` (the first one is how Crew knows the CLI is up; its detail
 *   names the options it declared, `perTaskStopAffordance` and
 *   `forwardSubagentText`), `interrupt` (which
 *   also ends the turn running, and with `cancel_queued`, its detail, drops
 *   the messages waiting for a turn), `set_model` and `set_permission_mode`
 *   (which change what the next turn says), and the rest. Each but
 *   `get_context_usage`, which Crew asks on its own schedule, is appended to
 *   $HOME/fake-claude-control.log as `<subtype> <detail>`, one a line.
 * - The MCP servers it reports, in `system/init` and as the answer to
 *   `mcp_status` (which, like `get_context_usage`, stays out of the control
 *   log), are the ones in $HOME/fake-claude-mcp.json, a list of
 *   `{name, status, error?}` as the real CLI names them (`connected`,
 *   `needs-auth`, `failed`, `pending`); none while the file is not there.
 * - A `user` message is a turn: `system/init`, the message echoed back when
 *   `--replay-user-messages` is on, the reply streamed a word at a time as
 *   `stream_event` deltas, the `assistant` message with its usage, and the
 *   `result`. The reply is `Reply <n>: <message>`, <n> counting the turns
 *   this process has served, so a second turn on the same process says 2.
 *   A message of several lines is answered whole, its lines joined by " / ".
 *   A message that arrives during a turn is taken into it, as the real CLI
 *   does at its next step: echoed at once (with `--replay-user-messages`),
 *   written to the transcript, and named in the turn's reply as a paragraph
 *   of its own, `Also: <first line>`, after what the turn was saying. One
 *   that arrives once the reply is complete waits for a turn of its own.
 *   A message that starts with `late ` is echoed three seconds after it came
 *   instead of at once: the turn has not read it yet in between.
 * - `work N` is a turn that takes N seconds before it starts to answer, for
 *   a test that stops it.
 * - `agent` is a turn that sends a subagent to the background (`ag1`, then
 *   `ag2`…) as 2.1.295 reports one: the Agent call, `task_started`, the
 *   subagent's own frame, and a `task_progress` with 41300 tokens on its step
 *   "Reading README.md". It runs until a `stop_task` for it, which ends it as
 *   `stopped`; the turn itself answers at once.
 * - `shell` is a turn that sends a shell, `npm test`, to the background
 *   (`sh1`) beside the subagents that run; it runs until the session ends.
 * - `initialize` answers the `/` menu: the commands `cold-run`, `compact` and
 *   `context`, and `writing-for-agents`, which `reload_skills` names a skill
 *   (as `system/init`'s `skills` does each turn). `reload_plugins` answers
 *   the same commands.
 * - The context is 20k tokens a turn of the 200k window (compacting at 160k),
 *   in the usage of each reply and in the answer to `get_context_usage`, none
 *   before the first turn.
 * - The conversation is written to the CLI's own transcript, so a relaunch
 *   can resume it.
 */
function serve() {
  const WINDOW = 200_000;
  const STEP = 20_000;
  const WORD_MS = 150;
  const replay = argv.includes("--replay-user-messages");
  const SKILLS = ["writing-for-agents"];
  const MENU = [
    { name: "cold-run", description: "Run the cold start check", argumentHint: "<folder>" },
    { name: "writing-for-agents", description: "Write documents for agents", argumentHint: "" },
    { name: "compact", description: "Free up context", argumentHint: "<hint>" },
    { name: "context", description: "Show what fills the context", argumentHint: "" },
  ];
  const emit = (entry) => process.stdout.write(`${JSON.stringify(entry)}\n`);
  const answer = (id, response) => emit({ type: "control_response", response: { subtype: "success", request_id: id, response } });
  const waiting = [];
  let current = null;
  let turns = 0;
  let buffer = "";

  const textOf = (message) => {
    const content = message && message.content;
    if (typeof content === "string") return content;
    if (!Array.isArray(content)) return "";
    return content.filter((part) => part && part.type === "text").map((part) => part.text).join("\n");
  };
  const used = () => STEP * Math.min(turns, 9);
  const servers = () => {
    try {
      return JSON.parse(fs.readFileSync(path.join(HOME, "fake-claude-mcp.json"), "utf8"));
    } catch {
      return [];
    }
  };

  function control(rec) {
    const request = rec.request || {};
    const subtype = request.subtype;
    if (subtype === "get_context_usage") {
      return answer(rec.request_id, {
        totalTokens: used(),
        maxTokens: WINDOW,
        rawMaxTokens: WINDOW,
        autoCompactThreshold: 160_000,
        isAutoCompactEnabled: true,
        model: model || "fake",
      });
    }
    if (subtype === "mcp_status") return answer(rec.request_id, { mcpServers: servers() });
    let detail = request.task_id || "";
    if (subtype === "set_model") detail = request.model || "";
    if (subtype === "set_permission_mode") detail = request.mode || "";
    if (subtype === "apply_flag_settings") detail = JSON.stringify(request.settings);
    if (subtype === "initialize") detail = ["perTaskStopAffordance", "forwardSubagentText"].filter((option) => request[option]).join(" ");
    if (subtype === "interrupt" && request.cancel_queued) detail = "cancel_queued";
    if (subtype === "set_model") model = request.model || null;
    if (subtype === "set_permission_mode" && request.mode) mode = request.mode;
    fs.appendFileSync(path.join(HOME, "fake-claude-control.log"), `${subtype} ${detail}\n`);
    const reply = {
      get_task_output: { output: "", total_bytes: 0, truncated: false },
      initialize: { commands: MENU },
      reload_plugins: { commands: MENU, agents: [], plugins: [], mcpServers: [] },
      reload_skills: { skills: SKILLS.map((name) => ({ name })) },
    };
    answer(rec.request_id, reply[subtype] || {});
    if (subtype === "stop_task" && agents.has(request.task_id)) endAgent(request.task_id);
    if (subtype === "interrupt") {
      if (request.cancel_queued) waiting.length = 0;
      stop();
    }
  }

  /** The subagents sent to the background, by task id, with the call that started each. */
  const agents = new Map();

  function startAgent() {
    const n = agents.size + 1;
    const task = `ag${n}`;
    const call = `toolu_ag${n}`;
    agents.set(task, call);
    const input = { description: "Explore the repo", subagent_type: "Explore", prompt: "Look around", run_in_background: true };
    emit({
      type: "assistant",
      session_id: sessionId,
      message: { id: `msg_ag${n}`, role: "assistant", content: [{ type: "tool_use", id: call, name: "Agent", input }] },
    });
    emit({
      type: "system",
      subtype: "task_started",
      session_id: sessionId,
      task_id: task,
      tool_use_id: call,
      description: input.description,
      subagent_type: "Explore",
      task_type: "local_agent",
      is_backgrounded: true,
      prompt: input.prompt,
    });
    emit({
      type: "system",
      subtype: "background_tasks_changed",
      session_id: sessionId,
      tasks: [{ task_id: task, task_type: "local_agent", description: input.description }],
    });
    emit({
      type: "assistant",
      session_id: sessionId,
      parent_tool_use_id: call,
      agent_id: task,
      message: { id: `msg_sub${n}`, role: "assistant", model: model || "fake", content: [{ type: "text", text: "Looking at README.md" }] },
    });
    emit({
      type: "system",
      subtype: "task_progress",
      session_id: sessionId,
      task_id: task,
      tool_use_id: call,
      description: "Reading README.md",
      subagent_type: "Explore",
      usage: { total_tokens: 41_300, tool_uses: 1, duration_ms: 926 },
      last_tool_name: "Read",
    });
  }

  /** A shell sent to the background (`sh1`) beside whatever subagents run: `task_started`, then the set. */
  function startShell() {
    emit({
      type: "system",
      subtype: "task_started",
      session_id: sessionId,
      task_id: "sh1",
      tool_use_id: "toolu_sh1",
      description: "npm test",
      task_type: "local_bash",
      is_backgrounded: true,
    });
    const tasks = [...agents.keys()].map((task_id) => ({ task_id, task_type: "local_agent", description: "Explore the repo" }));
    emit({
      type: "system",
      subtype: "background_tasks_changed",
      session_id: sessionId,
      tasks: [...tasks, { task_id: "sh1", task_type: "local_bash", description: "npm test" }],
    });
  }

  /** A `stop_task` for a subagent: it ends as stopped, and nothing wakes the model. */
  function endAgent(task) {
    const call = agents.get(task);
    agents.delete(task);
    emit({ type: "system", subtype: "task_updated", session_id: sessionId, task_id: task, patch: { status: "killed" } });
    emit({ type: "system", subtype: "task_notification", session_id: sessionId, task_id: task, tool_use_id: call, status: "stopped", summary: "Explore the repo" });
    emit({ type: "system", subtype: "background_tasks_changed", session_id: sessionId, tasks: [] });
  }

  /** The `interrupt` request: the turn running ends where it is, as an error result. */
  function stop() {
    if (!current) return;
    current.stopped = true;
    current.wake();
    current = null;
    interrupted(false);
    turnEnd();
    emit({
      type: "result",
      subtype: "error_during_execution",
      is_error: true,
      result: "[Request interrupted by user]",
      session_id: sessionId,
      total_cost_usd: 0,
      usage: {},
    });
    next();
  }

  function next() {
    if (current || waiting.length === 0) return;
    void turn(waiting.shift()).catch((error) => {
      process.stderr.write(`${error && error.stack ? error.stack : error}\n`);
      process.exit(1);
    });
  }

  async function turn(text) {
    const mine = { stopped: false, wake: () => {}, folded: [] };
    current = mine;
    const nap = (ms) =>
      new Promise((resolve) => {
        const timer = setTimeout(resolve, ms);
        mine.wake = () => {
          clearTimeout(timer);
          resolve();
        };
      });
    const n = ++turns;
    turnStarted = Date.now();
    emit({ type: "system", subtype: "init", session_id: sessionId, model: model || "fake", cwd: CWD, tools: [], skills: SKILLS, mcp_servers: servers() });
    if (replay) emit({ type: "user", session_id: sessionId, message: { role: "user", content: [{ type: "text", text }] } });
    record({ type: "user", permissionMode: mode, message: { role: "user", content: text } });

    const [command, seconds] = text.trim().split(/\s+/);
    let reply = `Reply ${n}: ${text.trim().replace(/\s*\n\s*/g, " / ")}`;
    const id = `msg_${randomUUID().slice(0, 8)}`;
    emit({ type: "stream_event", session_id: sessionId, event: { type: "message_start", message: { id, role: "assistant" } } });
    if (command === "work") {
      await nap(Math.max(0, Number(seconds) || 1) * 1000);
      if (mine.stopped) return;
    }
    if (command === "agent") startAgent();
    if (command === "shell") startShell();
    if (text.startsWith("!")) {
      await new Promise((resolve) => {
        const child = spawn("sh", ["-c", text.slice(1)], { cwd: CWD, env: process.env, stdio: "ignore" });
        child.on("exit", resolve);
        child.on("error", resolve);
      });
      if (mine.stopped) return;
    }
    const speak = async (words) => {
      for (const word of words.split(/(?<= )/)) {
        emit({
          type: "stream_event",
          session_id: sessionId,
          event: { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: word } },
        });
        await nap(WORD_MS);
        if (mine.stopped) return false;
      }
      return true;
    };
    if (!(await speak(reply))) return;
    // What came in meanwhile is in the turn: named after what it was saying.
    // A message that lands as the last word goes out is still in time.
    for (let seen = 0; seen < mine.folded.length; seen++) {
      const also = `\n\nAlso: ${mine.folded[seen].trim().split("\n")[0]}`;
      reply += also;
      if (!(await speak(also))) return;
    }
    const tokens = used();
    emit({
      type: "assistant",
      session_id: sessionId,
      message: {
        id,
        role: "assistant",
        usage: { input_tokens: tokens - 100, cache_read_input_tokens: 0, cache_creation_input_tokens: 0, output_tokens: 100 },
        content: [{ type: "text", text: reply }],
      },
    });
    say(reply);
    turnEnd();
    current = null;
    emit({
      type: "result",
      subtype: "success",
      is_error: false,
      result: reply,
      session_id: sessionId,
      total_cost_usd: 0,
      duration_ms: Date.now() - turnStarted,
      usage: { input_tokens: tokens - 100, output_tokens: 100 },
      modelUsage: { [model || "fake"]: { contextWindow: WINDOW } },
    });
    next();
  }

  const handle = (line) => {
    let rec;
    try {
      rec = JSON.parse(line);
    } catch {
      return;
    }
    if (rec.type === "control_request") return control(rec);
    if (rec.type !== "user") return;
    const text = textOf(rec.message);
    if (current && !current.stopped) {
      const running = current;
      running.folded.push(text);
      const take = () => {
        if (running.stopped) return;
        if (replay) emit({ type: "user", session_id: sessionId, message: { role: "user", content: [{ type: "text", text }] } });
        record({ type: "user", permissionMode: mode, message: { role: "user", content: text } });
      };
      // `late ...` is read after three seconds, a steer in flight for a test to see.
      if (text.startsWith("late ")) setTimeout(take, 3000);
      else take();
      return;
    }
    waiting.push(text);
    next();
  };

  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (chunk) => {
    buffer += chunk;
    for (let at = buffer.indexOf("\n"); at >= 0; at = buffer.indexOf("\n")) {
      const line = buffer.slice(0, at);
      buffer = buffer.slice(at + 1);
      if (line.trim()) handle(line);
    }
  });
  process.stdin.on("end", () => process.exit(0));
}
